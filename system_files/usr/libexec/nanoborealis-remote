    ("POST", "/nanoborealis/hands/ask"): hands_ask,
    ("GET", "/nanoborealis/hands/asks"): hands_asks_list,
    ("POST", "/nanoborealis/hands/answer"): hands_answer,
    ("GET", "/nanoborealis/agent/mode"): get_agent_mode,
    ("POST", "/nanoborealis/agent/mode"): set_agent_mode,
    ("GET", "/nanoborealis/rigs"): rigs_overview,
    ("POST", "/nanoborealis/rigs/up"): rigs_up,
    ("GET", "/nanoborealis/providers"): providers_overview,
    ("GET", "/nanoborealis/providers/models"): providers_models,
