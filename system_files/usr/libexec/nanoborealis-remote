    ("POST", "/nanoborealis/pool/policy"): pool_policy,
}


async def admin(method: str, target: str, headers: list[tuple[str, str]], reader: asyncio.StreamReader,
                writer: asyncio.StreamWriter, address: str) -> None:
    """The control center's endpoints: for devices paired by an administrator of this computer."""
    path, _, query_string = target.partition("?")
    device_id = devices.find(header(headers, DEVICE_HEADER))
    if device_id is None:
        return await reply(writer, 401, {"error": "This device isn't paired with this computer."})
    owner = owner_of(device_id)
    try:
        import pwd
        allowed = owner is not None and administrator(pwd.getpwnam(owner).pw_uid) is not None
    except (ImportError, KeyError):
        allowed = False
    if not allowed:
        return await reply(writer, 403, {"error": "Only devices paired by an administrator of this computer "
                                                  "can manage its agent."})
    devices.seen(device_id, address)
    data: dict = {}
    if method == "POST":
        try:
            length = int(header(headers, "content-length") or 0)
            if not 0 <= length <= ADMIN_BODY_LIMIT:
                raise ValueError("too long")
            data = json.loads(await asyncio.wait_for(reader.readexactly(length), 30) if length else b"{}")
            if not isinstance(data, dict):
                raise ValueError("not an object")
        except (ValueError, asyncio.TimeoutError, asyncio.IncompleteReadError):
            return await reply(writer, 400, {"error": "Bad request."})
    query = {k: v[-1] for k, v in urllib.parse.parse_qs(query_string).items()}
    try:
        if (method, path) in ADMIN_ROUTES:
            status, payload = await ADMIN_ROUTES[(method, path)](data, query, owner, device_id)
        else:
            status, payload = await asyncio.to_thread(hall_proxy, method, path[len(HALL_PREFIX) - 1:], query_string,
                                                      data if method == "POST" else None)
            if isinstance(payload, dict) and payload.get("deploy"):  # a rig went down or came back: its agent seats too
                payload.pop("tokens", None)
                await rig_deploy(payload)
    except (RuntimeError, OSError, subprocess.SubprocessError, ValueError) as e:
        log(f"managing the agent failed ({path}): {e}")
        status, payload = 502, {"error": str(e) if isinstance(e, RuntimeError) else f"That didn't work: {e}"}
    await reply(writer, status, payload)


# -- The app on this computer -------------------------------------------------------------------


def administrator(uid: int) -> str | None:
    """The account behind uid if it may pair this computer's own app: an administrator (wheel),
    never root or the agent's account. In tests, any ordinary account."""
    import grp
    import pwd
    try:
        account = pwd.getpwuid(uid)
    except KeyError:
        return None
    if uid == 0 or account.pw_name == AGENT_USER:
        return None
    if TEST_OWNER:
        return account.pw_name
    try:
        wheel = grp.getgrnam("wheel").gr_gid
    except KeyError:
        return None
    return account.pw_name if wheel in os.getgrouplist(account.pw_name, account.pw_gid) else None


async def pair_here(reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
    """Pairs the NanoBorealis app running on this computer, over a local socket and without a PIN:
    the kernel says who is asking, and an administrator signed in here needs no proof of presence."""
    import struct
    try:
        sock = writer.get_extra_info("socket")
        _pid, uid, _gid = struct.unpack("3i", sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                                              struct.calcsize("3i")))
        request = json.loads(await asyncio.wait_for(reader.readline(), 10) or b"{}")
        owner = administrator(uid)
        if owner is None:
            answer = {"error": "Only an administrator of this computer can pair its own NanoBorealis app."}
        else:
            name = clean_name(request.get("device") if isinstance(request, dict) else None) or f"This computer ({owner})"
            device_id, password = devices.add(name, "this computer", owner, here=True)
            log(f"paired {name} on this computer for {owner} as device {device_id}")
            answer = {"device_id": device_id, "password": password, "port": PORT, "machine": MACHINE,
                      "certificate": ssl.DER_cert_to_PEM_cert(CERT_DER)}
        writer.write(json.dumps(answer).encode() + b"\n")
        await writer.drain()
    except (OSError, ValueError, asyncio.TimeoutError):
        pass
    finally:
        writer.close()


async def serve_here() -> asyncio.AbstractServer | None:
    if os.name != "posix":
        return None
    path = Path(LOCAL_SOCKET)
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.unlink(missing_ok=True)
        server = await asyncio.start_unix_server(pair_here, path=str(path))
        os.chmod(path, 0o666)  # anyone may ask; pair_here decides from the kernel's word who is asking
    except OSError as e:
        log(f"the app on this computer can't pair by itself ({path}: {e}); it can still pair with a PIN")
        return None
    return server


def quiet_tls_errors(loop: asyncio.AbstractEventLoop, context: dict) -> None:
    # Scanners and dropped connections fail the TLS handshake all the time; that's not news.
    if isinstance(context.get("exception"), (ssl.SSLError, ConnectionError, TimeoutError)):
        return
    loop.default_exception_handler(context)


async def main() -> None:
    global CERT_DER
    cert, key, CERT_DER = certificate()
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    context.load_cert_chain(cert, key)
    asyncio.get_running_loop().set_exception_handler(quiet_tls_errors)
    server = await asyncio.start_server(handle, host=None, port=PORT, ssl=context, limit=HEAD_LIMIT,
                                        ssl_handshake_timeout=20)
    devices.load()
    log(f"pairing and paired devices on port {PORT} ({len(devices.by_id)} paired); certificate "
        f"{hashlib.sha256(CERT_DER).hexdigest()[:16]}")
    here = await serve_here()
    expiring = asyncio.create_task(expire_regularly())  # PINs of abandoned pairings leave the screen too
    freeing = asyncio.create_task(keep_agent_free())
    zoning = asyncio.create_task(keep_agent_time_zone())
    pointing = asyncio.create_task(follow_pool_api())
    # The agent's token for its hands tool, kept in its home (not in the tests' stand-in homes).
    keeping = asyncio.create_task(agent_token_keeper()) if TEST_AGENT_HOME is None else None
    async with server:
        await server.serve_forever()
    if keeping is not None:
        keeping.cancel()
    expiring.cancel()
    freeing.cancel()
    zoning.cancel()
    pointing.cancel()
    if here is not None:
        here.close()


if __name__ == "__main__":
    asyncio.run(main())
