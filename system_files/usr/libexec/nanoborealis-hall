"""The Hall: where the council's seats meet (docs/rigs/README.md).

One SQLite database holds the seats, the rooms (Hall chats) and their messages, the task board, the
votes, the trust ledger and the council's settings. Everything is JSON over HTTP, and every request
needs `Authorization: Bearer <token>`: the admin token (the computer's own services, like
nanoborealis-remote for the app) or a seat's own token (the council tools in that seat's agent).
Seats speak only as themselves; seats and people are managed with the admin token alone.

    nanoborealis-hall      # NANOBOREALIS_HALL_STATE (default /var/lib/nanoborealis/hall),
                           # NANOBOREALIS_HALL_LISTEN (default 127.0.0.1:11437)
"""

from __future__ import annotations

import hmac
import json
import os
import re
import secrets
import sqlite3
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlsplit

sys.path.insert(0, os.environ.get("NANOBOREALIS_TOOLS", "/usr/share/nanoborealis"))
try:
    import mixer  # several free models answering one question together
    import sources  # one question to one source, tokenized if it is on the internet
    import tokenizer  # what keeps personal details off the internet when the Hall asks a cloud model
except ImportError:  # without them nothing goes to the cloud: advise() sends only through the tokenizer
    mixer = sources = tokenizer = None
try:
    import rigs  # teams of seats as a file, the head agent, the watchdog's decisions, restore
except ImportError:
    rigs = None
# The owner's switch (also the relay's): with it set, no question leaves for a cloud model at all.
CLOUD_OFF = os.environ.get("NANOBOREALIS_MIX_SENSITIVITY") == "local-only"

STATE =Path(os.environ.get("NANOBOREALIS_HALL_STATE", "/var/lib/nanoborealis/hall"))
LISTEN = os.environ.get("NANOBOREALIS_HALL_LISTEN", "127.0.0.1:11437")
MAX_BODY = 1024 * 1024
TEXT_LIMIT = 64 * 1024

DEFAULTS = {
    "autonomy": "on-task",  # or "continuous": seats also pick up open tasks by themselves
    "escalation": True,  # stuck or split: ask the escalation model (free models only)
    "escalation_model": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "escalation_mix": True,  # ask several free models of different makes and have the strongest combine them, not one
    "split_margin": 0.15,  # a vote won by less than this share of the weight is split
    "review_rejects_to_fail": 2,
}
TRUST_MIN, TRUST_MAX = 0.2, 3.0
TRUST_HALF_LIFE_DAYS = 30.0  # old praise and blame fade, and trust drifts back toward 1
TRUST_EVENTS = {"accepted": 0.05, "rejected": -0.05, "thumbs_up": 0.1, "thumbs_down": -0.1}
TASK_STATES = ("open", "claimed", "review", "done", "failed")
BENCH_AREAS = ("reasoning", "format", "fidelity", "tools", "review")  # nanobench.py's
BENCH_ABBREVIATIONS = {"reasoning": "reasoning", "format": "format", "fidelity": "fidelity", "tools": "tools", "review": "review"}
BENCH_DAYS = 30  # results older than this no longer count
BENCH_MIN_ITEMS = 10  # fewer than this and a score says nothing yet, so it doesn't move trust
SEAT_ID = re.compile(r"[a-z0-9][a-z0-9-]{0,39}")

SCHEMA = """
CREATE TABLE IF NOT EXISTS seats (
    id TEXT PRIMARY KEY, name TEXT NOT NULL, model TEXT NOT NULL, family TEXT NOT NULL DEFAULT '',
    capability REAL NOT NULL DEFAULT 50, chair INTEGER NOT NULL DEFAULT 0, token_hash TEXT NOT NULL,
    created REAL NOT NULL, seen REAL
);
CREATE TABLE IF NOT EXISTS rooms (
    id INTEGER PRIMARY KEY, title TEXT NOT NULL, kind TEXT NOT NULL DEFAULT 'hall', created REAL NOT NULL
);
CREATE TABLE IF NOT EXISTS messages (
    id INTEGER PRIMARY KEY, room INTEGER NOT NULL REFERENCES rooms(id), author TEXT NOT NULL,
    kind TEXT NOT NULL DEFAULT 'say', text TEXT NOT NULL, reply_to INTEGER, at REAL NOT NULL
);
CREATE TABLE IF NOT EXISTS tasks (
    id INTEGER PRIMARY KEY, title TEXT NOT NULL, detail TEXT NOT NULL DEFAULT '', author TEXT NOT NULL,
    room INTEGER REFERENCES rooms(id), state TEXT NOT NULL DEFAULT 'open', claimed_by TEXT,
    result TEXT, rejects INTEGER NOT NULL DEFAULT 0, created REAL NOT NULL, updated REAL NOT NULL
);
CREATE TABLE IF NOT EXISTS task_notes (
    id INTEGER PRIMARY KEY, task INTEGER NOT NULL REFERENCES tasks(id), author TEXT NOT NULL,
    kind TEXT NOT NULL, text TEXT NOT NULL, at REAL NOT NULL
);
CREATE TABLE IF NOT EXISTS votes (
    id INTEGER PRIMARY KEY, question TEXT NOT NULL, options TEXT NOT NULL, room INTEGER, task INTEGER,
    author TEXT NOT NULL, closed INTEGER NOT NULL DEFAULT 0, created REAL NOT NULL
);
CREATE TABLE IF NOT EXISTS ballots (
    vote INTEGER NOT NULL REFERENCES votes(id), seat TEXT NOT NULL, choice TEXT NOT NULL,
    reason TEXT NOT NULL DEFAULT '', weight REAL NOT NULL, at REAL NOT NULL, PRIMARY KEY (vote, seat)
);
CREATE TABLE IF NOT EXISTS trust (
    id INTEGER PRIMARY KEY, seat TEXT NOT NULL, delta REAL NOT NULL, reason TEXT NOT NULL, at REAL NOT NULL
);
CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS benchmarks (
    id INTEGER PRIMARY KEY, model TEXT NOT NULL, suite TEXT NOT NULL, seed INTEGER NOT NULL, area TEXT NOT NULL,
    passed INTEGER NOT NULL, n INTEGER NOT NULL, at REAL NOT NULL
);
CREATE INDEX IF NOT EXISTS benchmarks_model ON benchmarks (model, at);
CREATE TABLE IF NOT EXISTS rigs (name TEXT PRIMARY KEY, culture TEXT NOT NULL DEFAULT '', spec TEXT NOT NULL, created REAL NOT NULL);
CREATE TABLE IF NOT EXISTS pods (rig TEXT NOT NULL, id TEXT NOT NULL, guidance TEXT NOT NULL DEFAULT '', PRIMARY KEY (rig, id));
CREATE TABLE IF NOT EXISTS edges (rig TEXT NOT NULL, src TEXT NOT NULL, dst TEXT NOT NULL, kind TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS inbox (
    id INTEGER PRIMARY KEY, rig TEXT, sender TEXT NOT NULL, recipient TEXT NOT NULL, kind TEXT NOT NULL DEFAULT 'message',
    text TEXT NOT NULL, state TEXT NOT NULL DEFAULT 'new', tries INTEGER NOT NULL DEFAULT 0, reply_to INTEGER,
    created REAL NOT NULL, delivered REAL, done REAL
);
CREATE INDEX IF NOT EXISTS inbox_recipient ON inbox (recipient, state);
CREATE TABLE IF NOT EXISTS snapshots (id INTEGER PRIMARY KEY, rig TEXT NOT NULL, label TEXT NOT NULL DEFAULT '', data TEXT NOT NULL, at REAL NOT NULL);
CREATE TABLE IF NOT EXISTS presence (seat TEXT PRIMARY KEY, at REAL NOT NULL, status TEXT NOT NULL, note TEXT NOT NULL DEFAULT '');
CREATE TABLE IF NOT EXISTS turns (id INTEGER PRIMARY KEY, seat TEXT NOT NULL, session TEXT NOT NULL, role TEXT NOT NULL, text TEXT NOT NULL, at REAL NOT NULL);
CREATE INDEX IF NOT EXISTS turns_session ON turns (seat, session, id);
"""
CLOUD_TURNS = 12  # how much of a cloud seat's conversation in one room, task or inbox it is shown again
MIGRATIONS = [
    ("seats", "port", "INTEGER"),  # where its API is, on this computer (nanobot serve); none for the chair
    ("seats", "api_key", "TEXT"),  # the Hall's key to that API
    ("rooms", "seat", "TEXT"),  # a one-on-one room's seat
    # An outside seat: an agent that joins over the API (Claude Code, say) and isn't run by the pool. The Hall
    # can't ask it, so a vote doesn't wait for it; and it sees the Hall tokenized (see handler()).
    ("seats", "external", "INTEGER NOT NULL DEFAULT 0"),
    # Where a seat sits in a rig (rigs.py), and its place in line to be the head agent.
    ("seats", "rig", "TEXT"), ("seats", "pod", "TEXT"), ("seats", "role", "TEXT"), ("seats", "policy", "TEXT"),
    ("seats", "address", "TEXT"), ("seats", "guidance", "TEXT"), ("seats", "head_rank", "INTEGER"),
    # pool, outside or cloud (rigs.KINDS). A cloud seat is a free OpenRouter model the Hall asks itself.
    ("seats", "kind", "TEXT"),
]


def short_card(card: dict) -> str:
    """A model's overall benchmark as a few words, for beside its name; "" when it hasn't been benchmarked."""
    overall = card.get("overall")
    return f"benchmark {overall['score']:.0f} (sure >= {overall['lo']:.0f}, {overall['n']} items)" if overall else ""


def card_text(card: dict) -> str:
    """Every area of a scorecard, for the council to compare."""
    if not card:
        return "not benchmarked yet"
    parts = [f"{BENCH_ABBREVIATIONS.get(a, a)} {r['score']:.0f} (>= {r['lo']:.0f})" for a, r in card.items() if a != "overall"]
    overall = card["overall"]
    return ", ".join(parts) + f"; overall {overall['score']:.0f} (>= {overall['lo']:.0f}, {overall['n']} items)"


class Refused(Exception):
    def __init__(self, status: int, message: str):
        super().__init__(message)
        self.status = status


def digest(token: str) -> str:
    import hashlib
    return hashlib.sha256(token.encode()).hexdigest()


def text(value: object, what: str, limit: int = TEXT_LIMIT, required: bool = True) -> str:
    if value is None and not required:
        return ""
    if not isinstance(value, str) or (required and not value.strip()):
        raise Refused(400, f"{what} is missing.")
    if len(value) > limit:
        raise Refused(413, f"{what} is too long.")
    return value.strip()


class Hall:
    def __init__(self, state: Path):
        state.mkdir(parents=True, exist_ok=True)
        self.path = state / "hall.sqlite"
        self.lock = threading.Lock()  # one writer at a time; SQLite's own locking backs it up
        self.db = sqlite3.connect(self.path, check_same_thread=False, isolation_level=None)
        self.db.row_factory = sqlite3.Row
        self.db.execute("PRAGMA journal_mode=WAL")
        self.db.executescript(SCHEMA)
        for table, column, kind in MIGRATIONS:  # columns added after a database was first made
            if column not in {r["name"] for r in self.db.execute(f"PRAGMA table_info({table})")}:
                self.db.execute(f"ALTER TABLE {table} ADD COLUMN {column} {kind}")
        self.events: list[tuple] = []  # what the orchestrator should act on, once the change is saved
        token_file = state / "admin.token"
        if not token_file.exists():
            old = os.umask(0o077)
            try:
                token_file.write_text(secrets.token_urlsafe(32) + "\n")
            finally:
                os.umask(old)
        self.admin_hash = digest(token_file.read_text().strip())

    # -- Who's asking --------------------------------------------------------------------------------

    def who(self, token: str) -> str | None:
        """"admin", a seat's id, or None."""
        if not token:
            return None
        hashed = digest(token)
        if hmac.compare_digest(hashed, self.admin_hash):
            return "admin"
        row = self.db.execute("SELECT id FROM seats WHERE token_hash = ?", (hashed,)).fetchone()
        if row:
            self.db.execute("UPDATE seats SET seen = ? WHERE id = ?", (time.time(), row["id"]))
            return row["id"]
        return None

    # -- Settings and trust --------------------------------------------------------------------------

    def settings(self) -> dict:
        found = dict(DEFAULTS)
        for row in self.db.execute("SELECT key, value FROM settings"):
            found[row["key"]] = json.loads(row["value"])
        return found

    def set_settings(self, changes: dict) -> dict:
        for key, value in changes.items():
            if key not in DEFAULTS:
                raise Refused(400, f"Unknown setting {key}.")
            if key == "autonomy" and value not in ("on-task", "continuous"):
                raise Refused(400, "autonomy is on-task or continuous.")
            if key == "escalation" and not isinstance(value, bool):
                raise Refused(400, "escalation is true or false.")
            if key == "escalation_mix" and not isinstance(value, bool):
                raise Refused(400, "escalation_mix is true or false.")
            if key == "escalation_model" and not (isinstance(value, str) and value.endswith(":free")):
                raise Refused(400, "The escalation model must be a free one (its id ends in :free).")
            if key == "split_margin" and not (isinstance(value, (int, float)) and 0 <= value < 1):
                raise Refused(400, "split_margin is between 0 and 1.")
            if key == "review_rejects_to_fail" and not (isinstance(value, int) and 1 <= value <= 10):
                raise Refused(400, "review_rejects_to_fail is 1 to 10.")
            self.db.execute("INSERT OR REPLACE INTO settings VALUES (?, ?)", (key, json.dumps(value)))
        return self.settings()

    def trust(self, seat: str, now: float | None = None) -> float:
        """1, plus what reviews and thumbs have earned or cost (fading with time), plus the benchmark term:
        what the model's own NanoBench results say, which is the part of trust nobody's opinion can move."""
        now = now or time.time()
        total = 0.0
        for row in self.db.execute("SELECT delta, at FROM trust WHERE seat = ?", (seat,)):
            total += row["delta"] * 0.5 ** (max(0.0, now - row["at"]) / 86400 / TRUST_HALF_LIFE_DAYS)
        row = self.db.execute("SELECT model FROM seats WHERE id = ?", (seat,)).fetchone()
        if row:
            total += self.bench_term(row["model"], now)
        return round(min(TRUST_MAX, max(TRUST_MIN, 1.0 + total)), 3)

    # -- Benchmarks ----------------------------------------------------------------------------------

    def scorecard(self, model: str, now: float | None = None) -> dict:
        """{area: {score, lo, hi, n}, "overall": {...}} for a model, in percent, from the last BENCH_DAYS days.
        lo and hi are the 95% Wilson interval: a few items give a wide one, and the Hall trusts the low end."""
        now = now or time.time()
        card, total_passed, total_n = {}, 0, 0
        for row in self.db.execute("SELECT area, SUM(passed) AS p, SUM(n) AS n FROM benchmarks WHERE model = ? AND at > ? "
                                   "GROUP BY area ORDER BY area", (model, now - BENCH_DAYS * 86400)):
            card[row["area"]] = self.rate(row["p"], row["n"])
            total_passed, total_n = total_passed + row["p"], total_n + row["n"]
        if total_n:
            card["overall"] = self.rate(total_passed, total_n)
        return card

    @staticmethod
    def rate(passed: int, n: int) -> dict:
        import math
        z, p = 1.96, passed / n
        denom = 1 + z * z / n
        centre = (p + z * z / (2 * n)) / denom
        half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / denom
        return {"score": round(100 * p, 1), "lo": round(100 * max(0.0, centre - half), 1),
                "hi": round(100 * min(1.0, centre + half), 1), "n": n}

    def bench_term(self, model: str, now: float | None = None) -> float:
        """The benchmark part of trust: the low end of the overall score against a coin flip. Perfect over 30
        items is about +0.3; a coin flip over 30 is about -0.1; fewer than BENCH_MIN_ITEMS counts for nothing."""
        overall = self.scorecard(model, now).get("overall")
        if not overall or overall["n"] < BENCH_MIN_ITEMS:
            return 0.0
        return round(max(-0.3, min(0.4, (overall["lo"] / 100 - 0.5) * 0.8)), 4)

    def bench_record(self, data: dict) -> dict:
        """One NanoBench run for a model, posted by the computer's own services (a seat can't mark its own work)."""
        model = text(data.get("model"), "The model", 200)
        suite, seed, results = text(data.get("suite"), "The suite", 40), data.get("seed"), data.get("results")
        if isinstance(seed, bool) or not isinstance(seed, int) or not isinstance(results, dict) or not results:
            raise Refused(400, "A run has a seed and results per area.")
        rows = []
        for area, r in results.items():
            if area not in BENCH_AREAS or not isinstance(r, dict):
                raise Refused(400, f"An area is one of {', '.join(BENCH_AREAS)}.")
            passed, n = r.get("passed"), r.get("n")
            if any(isinstance(v, bool) or not isinstance(v, int) for v in (passed, n)) or not 0 <= passed <= n <= 500 or n == 0:
                raise Refused(400, f"{area}: passed and n are counts, with passed no more than n.")
            rows.append((area, passed, n))
        now = time.time()
        for area, passed, n in rows:
            self.db.execute("INSERT INTO benchmarks (model, suite, seed, area, passed, n, at) VALUES (?, ?, ?, ?, ?, ?, ?)",
                            (model, suite, seed, area, passed, n, now))
        card = self.scorecard(model)
        summary = ", ".join(f"{a} {r['score']:.0f}% (sure >= {r['lo']:.0f}%)" for a, r in card.items())
        for seat in self.db.execute("SELECT id FROM seats WHERE model = ?", (model,)).fetchall():  # on the ledger, to read
            self.add_trust(seat["id"], 0.0, f"benchmark {suite}: {summary}"[:500])
        return {"model": model, "scorecard": card, "trust_term": self.bench_term(model)}

    def benchmarks(self, model: str | None = None) -> list[dict]:
        rows = self.db.execute("SELECT * FROM benchmarks" + (" WHERE model = ?" if model else "") + " ORDER BY id DESC LIMIT 200",
                               (model,) if model else ())
        return [dict(r) for r in rows]

    def add_trust(self, seat: str, delta: float, reason: str) -> None:
        self.db.execute("INSERT INTO trust (seat, delta, reason, at) VALUES (?, ?, ?, ?)",
                        (seat, delta, reason, time.time()))

    def weight(self, seat: dict) -> float:
        """A seat's say in a vote: how capable its model is, times how far it has earned trust."""
        return round(max(1.0, float(seat["capability"])) / 100 * self.trust(seat["id"]), 4)

    # -- Seats ---------------------------------------------------------------------------------------

    def seat(self, seat_id: str) -> dict:
        row = self.db.execute("SELECT * FROM seats WHERE id = ?", (seat_id,)).fetchone()
        if not row:
            raise Refused(404, f"No seat {seat_id}.")
        found = {k: row[k] for k in row.keys() if k not in ("token_hash", "api_key")}
        found["chair"] = bool(found["chair"])
        found["external"] = bool(found.get("external"))
        found["scorecard"] = self.scorecard(found["model"])
        found["trust"] = self.trust(seat_id)
        found["weight"] = self.weight(found)
        return found

    def seats(self) -> list[dict]:
        return [self.seat(r["id"]) for r in self.db.execute("SELECT id FROM seats ORDER BY chair DESC, name")]

    def put_seat(self, data: dict) -> dict:
        seat_id = text(data.get("id"), "The seat's id", 40)
        if not SEAT_ID.fullmatch(seat_id):
            raise Refused(400, "A seat's id is lowercase letters, digits and dashes.")
        name, model = text(data.get("name"), "The seat's name", 60), text(data.get("model"), "The seat's model", 200)
        family = text(data.get("family"), "family", 40, required=False)
        capability = data.get("capability", 50)
        if isinstance(capability, bool) or not isinstance(capability, (int, float)) or not 0 <= capability <= 100:
            raise Refused(400, "capability is 0 to 100.")
        port = data.get("port")
        if port is not None and (isinstance(port, bool) or not isinstance(port, int) or not 1 <= port <= 65535):
            raise Refused(400, "port is a port number.")
        exists = self.db.execute("SELECT 1 FROM seats WHERE id = ?", (seat_id,)).fetchone()
        token = None
        if not exists or data.get("rotate"):
            token = secrets.token_urlsafe(32)
        if exists:
            self.db.execute("UPDATE seats SET name = ?, model = ?, family = ?, capability = ?, chair = ? WHERE id = ?",
                            (name, model, family, capability, int(bool(data.get("chair"))), seat_id))
            if token:
                self.db.execute("UPDATE seats SET token_hash = ? WHERE id = ?", (digest(token), seat_id))
        else:
            self.db.execute("INSERT INTO seats (id, name, model, family, capability, chair, token_hash, created) "
                            "VALUES (?, ?, ?, ?, ?, ?, ?, ?)", (seat_id, name, model, family, capability,
                                                                int(bool(data.get("chair"))), digest(token), time.time()))
        if "external" in data:  # left out: unchanged
            if data["external"] and (port is not None or data.get("chair")):
                raise Refused(400, "An outside seat has no API of its own and isn't the chair.")
            self.db.execute("UPDATE seats SET external = ? WHERE id = ?", (int(bool(data["external"])), seat_id))
        if "kind" in data:
            if data["kind"] not in ("agent", "pool", "outside", "cloud", None):
                raise Refused(400, "kind is agent, pool, outside or cloud.")
            if data["kind"] in ("cloud", "agent") and not model.endswith(":free"):
                raise Refused(400, "A cloud seat runs a free OpenRouter model (its id ends in :free).")
            self.db.execute("UPDATE seats SET kind = ? WHERE id = ?", (data["kind"], seat_id))
        for column in ("rig", "pod", "role", "policy", "address", "guidance"):  # where it sits in a rig; left out: unchanged
            if column in data:
                self.db.execute(f"UPDATE seats SET {column} = ? WHERE id = ?",
                                (text(data.get(column), column, 2000, required=False) or None, seat_id))
        if "head_rank" in data:
            rank = data["head_rank"]
            if rank is not None and (isinstance(rank, bool) or not isinstance(rank, int) or rank < 1):
                raise Refused(400, "head_rank is 1 for first in line.")
            self.db.execute("UPDATE seats SET head_rank = ? WHERE id = ?", (rank, seat_id))
        if "port" in data:  # left out: unchanged
            self.db.execute("UPDATE seats SET port = ? WHERE id = ?", (port, seat_id))
        port = self.db.execute("SELECT port FROM seats WHERE id = ?", (seat_id,)).fetchone()["port"]
        api_key = None
        if token and port is not None:  # the Hall's key to the seat's API, new with every token
            api_key = secrets.token_urlsafe(32)
            self.db.execute("UPDATE seats SET api_key = ? WHERE id = ?", (api_key, seat_id))
        found = self.seat(seat_id)
        if token:
            found["token"] = token  # shown once: whoever creates the seat hands it to the seat's agent
        if api_key:
            found["api_key"] = api_key
        return found

    def remove_seat(self, seat_id: str) -> dict:
        self.seat(seat_id)
        self.db.execute("DELETE FROM seats WHERE id = ?", (seat_id,))
        return {"removed": seat_id}

    # -- Rigs: teams of seats as a file --------------------------------------------------------------

    def need_rigs(self) -> None:
        if rigs is None:
            raise Refused(503, "Rigs need rigs.py, which isn't installed.")

    def rig_list(self) -> list[dict]:
        return [{"name": r["name"], "seats": self.db.execute("SELECT COUNT(*) FROM seats WHERE rig = ?", (r["name"],)).fetchone()[0],
                 "created": r["created"]} for r in self.db.execute("SELECT * FROM rigs ORDER BY name")]

    def rig(self, name: str) -> dict:
        row = self.db.execute("SELECT * FROM rigs WHERE name = ?", (name,)).fetchone()
        if not row:
            raise Refused(404, f"No rig {name}.")
        beats = {r["seat"]: dict(r) for r in self.db.execute("SELECT * FROM presence")}
        now = time.time()
        seats = []
        for r in self.db.execute("SELECT id FROM seats WHERE rig = ? ORDER BY head_rank IS NULL, head_rank, id", (name,)):
            seat = self.seat(r["id"])
            beat = beats.get(seat["id"])
            seat["mail_waiting"] = self.db.execute("SELECT COUNT(*) FROM inbox WHERE recipient = ? AND state != 'done'", (seat["id"],)).fetchone()[0]
            seat["here"] = (seat["port"] is not None or seat.get("kind") == "cloud" or bool(beat and now - beat["at"] <= (rigs.FRESH if rigs else 120)))
            seat["status"] = beat["status"] if beat else None
            seats.append(seat)
        return {"name": name, "culture": row["culture"], "created": row["created"], "seats": seats,
                "pods": [dict(p) for p in self.db.execute("SELECT id, guidance FROM pods WHERE rig = ? ORDER BY id", (name,))],
                "edges": [dict(e) for e in self.db.execute("SELECT src, dst, kind FROM edges WHERE rig = ?", (name,))],
                "snapshots": [dict(s) for s in self.db.execute("SELECT id, label, at FROM snapshots WHERE rig = ? ORDER BY id DESC LIMIT 10", (name,))]}

    def rig_apply(self, data: dict) -> dict:
        """`rig up`: the spec in `data["spec"]` (TOML text) becomes pods, seats, edges and a culture. With
        dry_run it only says what it would do. Seats that left the spec are removed; new outside seats get a token."""
        self.need_rigs()
        try:
            spec = rigs.parse(data["spec"]) if isinstance(data.get("spec"), str) else rigs.validate(data.get("spec") or {})
        except rigs.SpecError as error:
            raise Refused(400, "; ".join(error.errors)) from None
        existing = {s["id"]: s for s in self.seats()}
        plan = rigs.plan(spec, existing)
        if plan["taken"]:
            raise Refused(409, f"These seat ids already belong to another rig or the council: {', '.join(plan['taken'])}.")
        if data.get("dry_run"):
            return {"rig": spec["name"], "plan": plan, "dry_run": True}
        name = spec["name"]
        self.db.execute("INSERT OR REPLACE INTO rigs (name, culture, spec, created) VALUES (?, ?, ?, COALESCE((SELECT created FROM rigs "
                        "WHERE name = ?), ?))", (name, spec["culture"], json.dumps(spec), name, time.time()))
        self.db.execute("DELETE FROM pods WHERE rig = ?", (name,))
        self.db.execute("DELETE FROM edges WHERE rig = ?", (name,))
        for pod in spec["pods"]:
            self.db.execute("INSERT INTO pods (rig, id, guidance) VALUES (?, ?, ?)", (name, pod["id"], pod["guidance"]))
        for edge in spec["edges"]:
            self.db.execute("INSERT INTO edges (rig, src, dst, kind) VALUES (?, ?, ?, ?)", (name, edge["src"], edge["dst"], edge["kind"]))
        tokens = self.rig_seats(spec)
        agents = tokens.pop("agents", [])
        wanted = {s["id"] for s in spec["seats"]}
        gone = [r["id"] for r in self.db.execute("SELECT id FROM seats WHERE rig = ?", (name,)) if r["id"] not in wanted]
        for old in gone:
            self.remove_seat(old)
        # For `rig up` to do on the system: the agent seats' containers to (re)start, and the ones to stop.
        deploy = {"rig": spec, "agents": agents, "remove": gone}
        return {"rig": name, "plan": plan, "tokens": tokens, "deploy": deploy}

    def rig_seats(self, spec: dict) -> dict:
        """Make or update the spec's seats. Returns the tokens of the outside seats made new: shown once. An agent
        seat (its own container, rigagent.py) gets a port and new keys on every `rig up`; they're returned under
        "agents" for `rig up` to put in the seat's container, which it (re)starts."""
        tokens: dict = {}
        agents = []
        used = {r["port"] for r in self.db.execute("SELECT port FROM seats WHERE port IS NOT NULL")}
        for s in spec["seats"]:
            extra: dict = {}
            if s["kind"] == "agent":
                row = self.db.execute("SELECT port FROM seats WHERE id = ?", (s["id"],)).fetchone()
                port = row["port"] if row and row["port"] else next(p for p in range(8800, 9000) if p not in used)
                used.add(port)
                extra = {"port": port, "rotate": True}
            made = self.put_seat(extra | {"id": s["id"], "name": s["address"], "model": s["model"], "capability": s["capability"],
                                  "family": s["kind"] if s["kind"] != "pool" else "", "external": s["kind"] == "outside",
                                  "kind": s["kind"],
                                  "rig": spec["name"], "pod": s["pod"], "role": s["role"], "policy": s["policy"],
                                  "address": s["address"], "guidance": s["guidance"], "head_rank": s["head_rank"]})
            if s["kind"] == "agent":
                agents.append(s | {"rig": spec["name"], "port": made["port"], "token": made["token"], "api_key": made["api_key"]})
            elif "token" in made:
                tokens[s["address"]] = made["token"]
        if agents:
            tokens["agents"] = agents
        return tokens

    def rig_down(self, name: str, snapshot: bool = True) -> dict:
        """`rig down`: its seats, pods and edges go, after a snapshot by default. Mail and tasks stay, for `rig restore`."""
        self.rig(name)
        snap = self.rig_snapshot(name, "taken down") if snapshot else None
        gone = [r["id"] for r in self.db.execute("SELECT id FROM seats WHERE rig = ?", (name,))]
        for seat_id in gone:
            self.remove_seat(seat_id)
        for table in ("pods", "edges"):
            self.db.execute(f"DELETE FROM {table} WHERE rig = ?", (name,))
        self.db.execute("DELETE FROM rigs WHERE name = ?", (name,))
        return {"down": name, "snapshot": snap["id"] if snap else None, "deploy": {"remove": gone}}

    def rig_snapshot(self, name: str, label: str = "") -> dict:
        """Everything that makes the rig what it is, and the work in flight, to bring it back from."""
        rig = self.rig(name)
        keep = ("id", "address", "name", "model", "family", "capability", "external", "rig", "pod", "role", "policy", "guidance",
                "head_rank", "port")
        mine = {s["id"] for s in rig["seats"]}
        data = {"rig": {"name": name, "culture": rig["culture"]}, "pods": rig["pods"], "edges": rig["edges"],
                "seats": [{**{k: s.get(k) for k in keep}, "kind": s.get("kind") or ("outside" if s["external"] else "pool")} for s in rig["seats"]],
                "tasks": [t for t in self.tasks() if t["state"] in ("open", "claimed", "review") and (t["claimed_by"] in mine or not t["claimed_by"])],
                "mail": [dict(r) for r in self.db.execute("SELECT * FROM inbox WHERE rig = ? AND state != 'done'", (name,))]}
        cur = self.db.execute("INSERT INTO snapshots (rig, label, data, at) VALUES (?, ?, ?, ?)",
                              (name, text(label, "label", 200, required=False), json.dumps(data), time.time()))
        return {"id": cur.lastrowid, "rig": name, "seats": len(data["seats"]), "tasks": len(data["tasks"]), "mail": len(data["mail"])}

    def rig_restore(self, name: str, data: dict) -> dict:
        """`rig restore`: the latest snapshot (or the one in data["snapshot"]), seat by seat, saying honestly what came
        back. A seat whose model isn't available is not guessed at: it waits for you to decide."""
        self.need_rigs()
        wanted = data.get("snapshot")
        row = (self.db.execute("SELECT * FROM snapshots WHERE id = ? AND rig = ?", (wanted, name)).fetchone() if wanted
               else self.db.execute("SELECT * FROM snapshots WHERE rig = ? ORDER BY id DESC LIMIT 1", (name,)).fetchone())
        if not row:
            raise Refused(404, f"No snapshot of {name}.")
        snap = json.loads(row["data"])
        models = set(data["models"]) if isinstance(data.get("models"), list) else None
        current = {s["id"]: s for s in self.seats()}
        outcomes = rigs.restore_outcomes(snap, current, models)
        waiting = {o["seat"] for o in outcomes if o["outcome"] == "awaiting-decision"}
        self.db.execute("INSERT OR REPLACE INTO rigs (name, culture, spec, created) VALUES (?, ?, ?, COALESCE((SELECT created FROM rigs "
                        "WHERE name = ?), ?))", (name, snap["rig"]["culture"], json.dumps(snap["rig"]), name, time.time()))
        for pod in snap["pods"]:
            self.db.execute("INSERT OR REPLACE INTO pods (rig, id, guidance) VALUES (?, ?, ?)", (name, pod["id"], pod["guidance"]))
        self.db.execute("DELETE FROM edges WHERE rig = ?", (name,))
        tokens = {}
        agents = []
        for seat in snap["seats"]:
            if (seat["address"] or seat["id"]) in waiting or seat["id"] in current:
                continue  # waiting for a decision, or never left
            agent = seat.get("kind") == "agent"
            made = self.put_seat({k: seat[k] for k in ("id", "name", "model", "family", "capability", "rig", "pod", "role", "policy",
                                                       "address", "guidance", "head_rank")} | {"external": seat["kind"] == "outside",
                                                                                              "kind": seat.get("kind")}
                                 | ({"port": seat.get("port") or 8800 + len(current) + len(agents), "rotate": True} if agent else {}))
            if agent:
                agents.append(seat | {"port": made["port"], "token": made["token"], "api_key": made["api_key"]})
            elif "token" in made:
                tokens[seat["address"] or seat["id"]] = made["token"]
        for edge in snap["edges"]:
            self.db.execute("INSERT INTO edges (rig, src, dst, kind) VALUES (?, ?, ?, ?)", (name, edge["src"], edge["dst"], edge["kind"]))
        # The work in flight: mail not already there comes back, and work held by a seat that waits goes back on the board.
        for m in snap["mail"]:
            if not self.db.execute("SELECT 1 FROM inbox WHERE created = ? AND sender = ? AND recipient = ? AND text = ?",
                                   (m["created"], m["sender"], m["recipient"], m["text"])).fetchone():
                self.db.execute("INSERT INTO inbox (rig, sender, recipient, kind, text, state, tries, created) VALUES (?, ?, ?, ?, ?, 'new', 0, ?)",
                                (name, m["sender"], m["recipient"], m["kind"], m["text"], m["created"]))
        freed = []
        for task in snap["tasks"]:
            if any((s["address"] or s["id"]) in waiting and s["id"] == task.get("claimed_by") for s in snap["seats"]):
                self.reopen(task["id"])
                freed.append(task["id"])
        rig = {"name": name, "culture": snap["rig"].get("culture"), "pods": snap["pods"], "edges": snap["edges"],
               "seats": snap["seats"]}
        return {"snapshot": row["id"], "outcomes": outcomes, "tokens": tokens, "tasks_reopened": freed,
                "deploy": {"rig": rig, "agents": agents, "remove": []}}

    # -- Mail: a durable inbox for every seat ---------------------------------------------------------

    def resolve(self, who: str) -> dict:
        """The delivery guard: a name must be exactly one seat. An id or an address is; a bare name is only if one rig
        has it. Anything unclear is refused with the candidates, never guessed."""
        who = text(who, "The recipient", 100)
        rows = [dict(r) for r in self.db.execute("SELECT id, address FROM seats WHERE id = ? OR address = ?", (who, who))]
        if not rows and "@" not in who:
            rows = [dict(r) for r in self.db.execute("SELECT id, address FROM seats WHERE address LIKE ?", (who + "@%",))]
        if not rows:
            raise Refused(404, f"No seat called {who}.")
        if len(rows) > 1:
            raise Refused(409, f"{who} could be any of {', '.join(r['address'] or r['id'] for r in rows)}: name one.")
        return rows[0]

    def send(self, sender: str, data: dict) -> dict:
        """Mail to one seat, to a pod ("pod:rig/pod"), to a rig ("rig:name"), to "head", or to "you". Each recipient gets
        its own item, which stays until it is done."""
        kind = data.get("kind", "message")
        if kind not in ("message", "task", "nudge", "reply"):
            raise Refused(400, "Mail is a message, a task, a nudge or a reply.")
        body, to = text(data.get("text"), "The mail", 8000), text(data.get("to"), "Who it is for", 100)
        reply_to = data.get("reply_to") if isinstance(data.get("reply_to"), int) else None
        if to == "you":
            targets = [("you", None)]
        elif to == "head":
            head = self.head()["head"]
            if not head:
                raise Refused(404, "There is no head agent: no seats.")
            targets = [(head, self.db.execute("SELECT rig FROM seats WHERE id = ?", (head,)).fetchone()["rig"])]
        elif to.startswith(("rig:", "pod:")):
            if to.startswith("rig:"):
                rows = self.db.execute("SELECT id, rig FROM seats WHERE rig = ? AND id != ?", (to[4:], sender)).fetchall()
            else:
                rig_name, _, pod = to[4:].partition("/")
                rows = self.db.execute("SELECT id, rig FROM seats WHERE rig = ? AND pod = ? AND id != ?", (rig_name, pod, sender)).fetchall()
            if not rows:
                raise Refused(404, f"No seats at {to}.")
            targets = [(r["id"], r["rig"]) for r in rows]
        else:
            seat = self.resolve(to)
            targets = [(seat["id"], self.db.execute("SELECT rig FROM seats WHERE id = ?", (seat["id"],)).fetchone()["rig"])]
        ids = []
        for recipient, rig_name in targets:
            cur = self.db.execute("INSERT INTO inbox (rig, sender, recipient, kind, text, reply_to, created) VALUES (?, ?, ?, ?, ?, ?, ?)",
                                  (rig_name, sender, recipient, kind, body, reply_to, time.time()))
            ids.append(cur.lastrowid)
            self.events.append(("inbox", cur.lastrowid))
        return {"sent": ids, "to": [t[0] for t in targets]}

    def mail(self, seat: str, state: str | None = None) -> list[dict]:
        if state and state not in ("new", "delivered", "done", "dead"):
            raise Refused(400, "Mail is new, delivered, done or dead.")
        rows = self.db.execute("SELECT * FROM inbox WHERE recipient = ?" + (" AND state = ?" if state else " AND state != 'done'")
                               + " ORDER BY id LIMIT 200", (seat, state) if state else (seat,))
        return [dict(r) for r in rows]

    def ack(self, item_id: int, who: str, state: str) -> dict:
        row = self.db.execute("SELECT * FROM inbox WHERE id = ?", (item_id,)).fetchone()
        if not row:
            raise Refused(404, f"No mail {item_id}.")
        if who != "admin" and row["recipient"] != who:
            raise Refused(403, "That isn't your mail.")
        if state not in ("delivered", "done"):
            raise Refused(400, "Mail is acknowledged as delivered or done.")
        column = "done" if state == "done" else "delivered"
        self.db.execute(f"UPDATE inbox SET state = ?, {column} = ? WHERE id = ?", (state, time.time(), item_id))
        return dict(self.db.execute("SELECT * FROM inbox WHERE id = ?", (item_id,)).fetchone())

    # -- Presence and the head agent -----------------------------------------------------------------

    def beat(self, seat: str, data: dict) -> dict:
        """A seat that isn't run by the pool says it is here, and whether its usage is spent."""
        status = data.get("status", "ok")
        if status not in ("ok", "limited", "busy"):
            raise Refused(400, "status is ok, limited or busy.")
        note = text(data.get("note"), "note", 200, required=False)
        self.db.execute("INSERT OR REPLACE INTO presence (seat, at, status, note) VALUES (?, ?, ?, ?)", (seat, time.time(), status, note))
        return self.head()

    def activity(self, since: float = 0.0) -> dict:
        """What the crew is doing right now, and what passed between them since `since`: the app's live map.
        An event is {at, kind, src, dst, text, task}: dst is who it went to (None: everyone)."""
        now = time.time()
        busy = []
        for seat, b in list(BUSY.items()):
            words, task = doing(b["session"])
            step = STEPS.get(seat) or {}
            busy.append({"seat": seat, "doing": words, "task": task, "since": b["since"],
                         "step": step.get("note") if now - step.get("at", 0) < 180 else None})
        since = max(since, now - 3600)
        events = []
        for n in self.db.execute("SELECT task_notes.*, tasks.claimed_by, tasks.title FROM task_notes JOIN tasks ON tasks.id = "
                                 "task_notes.task WHERE task_notes.at > ? ORDER BY task_notes.at DESC LIMIT 60", (since,)):
            other = n["claimed_by"] if n["claimed_by"] != n["author"] else None
            events.append({"at": n["at"], "kind": n["kind"], "src": n["author"], "dst": other, "task": n["task"],
                           "text": (n["text"] or n["title"])[:300]})
        for m in self.db.execute("SELECT * FROM inbox WHERE created > ? ORDER BY created DESC LIMIT 60", (since,)):
            events.append({"at": m["created"], "kind": "message", "src": m["sender"], "dst": m["recipient"], "task": None,
                           "text": m["text"][:300]})
        for m in self.db.execute("SELECT * FROM messages WHERE at > ? AND kind = 'say' ORDER BY at DESC LIMIT 60", (since,)):
            events.append({"at": m["at"], "kind": "say", "src": m["author"], "dst": None, "task": None, "text": m["text"][:300]})
        events.sort(key=lambda e: e["at"])
        return {"now": now, "busy": busy, "events": events[-80:]}

    def step(self, seat: str, data: dict) -> dict:
        """A seat's own agent says which tool it is using right now (its gate sends this)."""
        STEPS[seat] = {"note": text(data.get("note"), "note", 200, required=False) or "", "at": time.time()}
        return {"ok": True}

    def head(self) -> dict:
        """Who leads now: the first seat in line that is here, else the strongest the Hall can ask, else the chair."""
        self.need_rigs()
        presence = {r["seat"]: dict(r) for r in self.db.execute("SELECT * FROM presence")}
        found = rigs.pick_head(self.seats(), presence, time.time())
        return found

    # -- The watchdog --------------------------------------------------------------------------------

    def watchdog_scan(self, now: float, mail_after: float, task_after: float) -> dict:
        """Look for mail nobody has taken and work nobody has touched. Returns what to deliver again, and what it did."""
        self.need_rigs()
        # Only mail for seats the Hall can ask: an outside seat's mail waits for it, however long that takes.
        items = [dict(r) for r in self.db.execute("SELECT inbox.* FROM inbox JOIN seats ON seats.id = inbox.recipient "
                                                  "WHERE inbox.state = 'new' AND (seats.port IS NOT NULL OR seats.kind = 'cloud')")]
        again, give_up = rigs.overdue_mail(items, now, mail_after)
        for item in again:
            self.db.execute("UPDATE inbox SET tries = tries + 1 WHERE id = ?", (item["id"],))
        for item in give_up:
            self.db.execute("UPDATE inbox SET state = 'dead' WHERE id = ?", (item["id"],))
            if item["recipient"] != "you":
                self.send("hall", {"to": "head", "text": f"Mail {item['id']} from {item['sender']} to {item['recipient']} was never taken: "
                                                         f"{item['text'][:200]}"}) if self.seats() else None
        held = []
        for t in self.db.execute("SELECT * FROM tasks WHERE state = 'claimed'"):
            word = self.db.execute("SELECT MAX(at) FROM task_notes WHERE task = ? AND kind != 'nudge'", (t["id"],)).fetchone()[0]
            nudges = self.db.execute("SELECT COUNT(*) FROM task_notes WHERE task = ? AND kind = 'nudge'", (t["id"],)).fetchone()[0]
            held.append({"id": t["id"], "state": t["state"], "claimed_by": t["claimed_by"], "title": t["title"],
                         "last_word": max(t["updated"], word or 0), "nudges": nudges})
        nudge, reopen = rigs.stale_tasks(held, now, task_after)
        for task in nudge:
            self.note(task["id"], "hall", "nudge", "Still on this? Say where it stands, or hand it in.")
            self.db.execute("UPDATE tasks SET updated = ? WHERE id = ?", (now, task["id"]))
            self.send("hall", {"to": task["claimed_by"], "kind": "nudge", "text": f"Task {task['id']} ({task['title']}) has been quiet. Say where it stands."})
        for task in reopen:
            self.reopen(task["id"])
            self.events.append(("task", task["id"]))  # offered to the seats again
        return {"again": [i["id"] for i in again], "given_up": [i["id"] for i in give_up],
                "nudged": [t["id"] for t in nudge], "reopened": [t["id"] for t in reopen]}

    # -- Rooms ---------------------------------------------------------------------------------------

    def rooms(self) -> list[dict]:
        return [dict(r) for r in self.db.execute("SELECT * FROM rooms ORDER BY id DESC")]

    def new_room(self, data: dict) -> dict:
        title = text(data.get("title"), "The room's title", 200)
        kind = data.get("kind", "hall")
        if kind not in ("hall", "task", "direct"):
            raise Refused(400, "A room is a hall, a task or a direct (one-on-one) room.")
        seat = None
        if kind == "direct":  # you and one seat: only it answers
            seat = self.seat(text(data.get("seat"), "The seat", 40))["id"]
        cur = self.db.execute("INSERT INTO rooms (title, kind, seat, created) VALUES (?, ?, ?, ?)",
                              (title, kind, seat, time.time()))
        return dict(self.db.execute("SELECT * FROM rooms WHERE id = ?", (cur.lastrowid,)).fetchone())

    def room(self, room_id: int) -> dict:
        row = self.db.execute("SELECT * FROM rooms WHERE id = ?", (room_id,)).fetchone()
        if not row:
            raise Refused(404, f"No room {room_id}.")
        return dict(row)

    def messages(self, room_id: int, after: int = 0, limit: int = 200) -> list[dict]:
        self.room(room_id)
        found = [dict(r) for r in self.db.execute(
            "SELECT * FROM messages WHERE room = ? AND id > ? ORDER BY id LIMIT ?", (room_id, after, limit))]
        cards: dict[str, str] = {}
        for message in found:  # who is speaking, as their benchmarks put it, so every reader can weigh the words
            author = message["author"]
            if author not in cards:
                row = self.db.execute("SELECT model FROM seats WHERE id = ?", (author,)).fetchone()
                cards[author] = short_card(self.scorecard(row["model"])) if row else ""
            message["card"] = cards[author]
        return found

    def post(self, room_id: int, author: str, data: dict) -> dict:
        self.room(room_id)
        kind = data.get("kind", "say")
        if kind not in ("say", "pass", "escalation", "system"):
            raise Refused(400, "A message is say, pass, escalation or system.")
        if kind == "system" and author != "you":
            raise Refused(403, "Only the Hall itself posts system messages.")
        body = text(data.get("text"), "The message", required=kind != "pass") or "(passes)"
        reply_to = data.get("reply_to")
        if reply_to is not None and not isinstance(reply_to, int):
            raise Refused(400, "reply_to is a message id.")
        cur = self.db.execute("INSERT INTO messages (room, author, kind, text, reply_to, at) VALUES (?, ?, ?, ?, ?, ?)",
                              (room_id, author, kind, body, reply_to, time.time()))
        if author == "you" and kind == "say":
            self.events.append(("room", room_id))
        elif kind == "escalation":
            self.events.append(("escalation", room_id, cur.lastrowid))
        return dict(self.db.execute("SELECT * FROM messages WHERE id = ?", (cur.lastrowid,)).fetchone())

    # -- Tasks ---------------------------------------------------------------------------------------

    def task(self, task_id: int) -> dict:
        row = self.db.execute("SELECT * FROM tasks WHERE id = ?", (task_id,)).fetchone()
        if not row:
            raise Refused(404, f"No task {task_id}.")
        found = dict(row)
        found["notes"] = [dict(r) for r in self.db.execute(
            "SELECT author, kind, text, at FROM task_notes WHERE task = ? ORDER BY id", (task_id,))]
        return found

    def tasks(self, state: str | None = None) -> list[dict]:
        if state and state not in TASK_STATES:
            raise Refused(400, f"A task's state is one of {', '.join(TASK_STATES)}.")
        rows = self.db.execute("SELECT id FROM tasks" + (" WHERE state = ?" if state else "") + " ORDER BY id DESC",
                               (state,) if state else ())
        return [self.task(r["id"]) for r in rows]

    def note(self, task_id: int, author: str, kind: str, body: str) -> None:
        self.db.execute("INSERT INTO task_notes (task, author, kind, text, at) VALUES (?, ?, ?, ?, ?)",
                        (task_id, author, kind, body, time.time()))
        self.db.execute("UPDATE tasks SET updated = ? WHERE id = ?", (time.time(), task_id))

    def new_task(self, author: str, data: dict) -> dict:
        title = text(data.get("title"), "The task's title", 200)
        detail = text(data.get("detail"), "detail", required=False)
        room = data.get("room")
        if room is not None:
            self.room(room)
        now = time.time()
        cur = self.db.execute("INSERT INTO tasks (title, detail, author, room, created, updated) VALUES (?, ?, ?, ?, ?, ?)",
                              (title, detail, author, room, now, now))
        self.events.append(("task", cur.lastrowid))
        return self.task(cur.lastrowid)

    def claim(self, task_id: int, seat: str) -> dict:
        found = self.task(task_id)
        if found["state"] != "open":
            raise Refused(409, f"Task {task_id} is {found['state']}, not open.")
        self.db.execute("UPDATE tasks SET state = 'claimed', claimed_by = ? WHERE id = ?", (seat, task_id))
        self.note(task_id, seat, "claim", "claimed it")
        return self.task(task_id)

    def update(self, task_id: int, seat: str, data: dict) -> dict:
        found = self.task(task_id)
        if found["claimed_by"] != seat or found["state"] != "claimed":
            raise Refused(409, "Only the seat working on a task can add progress to it.")
        self.note(task_id, seat, "progress", text(data.get("text"), "The progress note"))
        return self.task(task_id)

    def submit(self, task_id: int, seat: str, data: dict) -> dict:
        found = self.task(task_id)
        if found["claimed_by"] != seat or found["state"] != "claimed":
            raise Refused(409, "Only the seat working on a task can hand it in.")
        result = text(data.get("result"), "The result")
        self.db.execute("UPDATE tasks SET state = 'review', result = ? WHERE id = ?", (result, task_id))
        self.note(task_id, seat, "submit", "handed it in for review")
        self.events.append(("review", task_id))
        return self.task(task_id)

    def review(self, task_id: int, reviewer: str, data: dict) -> dict:
        """Another seat (or you) accepts the result, or sends it back. Enough rejections fail it."""
        found = self.task(task_id)
        if found["state"] != "review":
            raise Refused(409, f"Task {task_id} isn't waiting for review.")
        if reviewer == found["claimed_by"]:
            raise Refused(403, "A seat can't review its own work.")
        verdict = data.get("verdict")
        if verdict not in ("accept", "reject"):
            raise Refused(400, "The verdict is accept or reject.")
        reason = text(data.get("text"), "reason", required=verdict == "reject")
        worker = found["claimed_by"]
        self.note(task_id, reviewer, verdict, reason or "accepted")
        if verdict == "accept":
            self.db.execute("UPDATE tasks SET state = 'done' WHERE id = ?", (task_id,))
            self.add_trust(worker, TRUST_EVENTS["accepted"], f"task {task_id} accepted by {reviewer}")
        else:
            rejects = found["rejects"] + 1
            failed = rejects >= self.settings()["review_rejects_to_fail"]
            self.db.execute("UPDATE tasks SET rejects = ?, state = ?, claimed_by = ? WHERE id = ?",
                            (rejects, "failed" if failed else "claimed", worker, task_id))
            self.add_trust(worker, TRUST_EVENTS["rejected"], f"task {task_id} rejected by {reviewer}")
            self.events.append(("failed" if failed else "revise", task_id))
        return self.task(task_id)

    def reopen(self, task_id: int) -> dict:
        self.task(task_id)
        self.db.execute("UPDATE tasks SET state = 'open', claimed_by = NULL, result = NULL, rejects = 0 WHERE id = ?",
                        (task_id,))
        self.note(task_id, "you", "reopen", "opened it again")
        return self.task(task_id)

    # -- Votes ---------------------------------------------------------------------------------------

    def vote(self, vote_id: int) -> dict:
        row = self.db.execute("SELECT * FROM votes WHERE id = ?", (vote_id,)).fetchone()
        if not row:
            raise Refused(404, f"No vote {vote_id}.")
        found = dict(row)
        found["options"] = json.loads(found["options"])
        found["closed"] = bool(found["closed"])
        ballots = [dict(r) for r in self.db.execute("SELECT * FROM ballots WHERE vote = ? ORDER BY at", (vote_id,))]
        found["ballots"] = ballots
        totals = {option: 0.0 for option in found["options"]}
        for ballot in ballots:
            totals[ballot["choice"]] += ballot["weight"]
        weight = sum(totals.values())
        ranked = sorted(totals.items(), key=lambda kv: -kv[1])
        margin = (ranked[0][1] - (ranked[1][1] if len(ranked) > 1 else 0)) / weight if weight else 0.0
        found["tally"] = {k: round(v, 4) for k, v in ranked}
        found["leading"] = ranked[0][0] if weight else None
        found["margin"] = round(margin, 4)
        found["split"] = bool(weight) and margin < self.settings()["split_margin"]
        # The chair and outside seats may vote, but a vote doesn't wait for them: the Hall can't ask them.
        waiting = {s["id"] for s in self.seats() if not s["chair"] and not s["external"]} - {b["seat"] for b in ballots}
        found["waiting_for"] = sorted(waiting)
        return found

    def votes(self, open_only: bool = False) -> list[dict]:
        rows = self.db.execute("SELECT id FROM votes" + (" WHERE closed = 0" if open_only else "") + " ORDER BY id DESC")
        return [self.vote(r["id"]) for r in rows]

    def new_vote(self, author: str, data: dict) -> dict:
        question = text(data.get("question"), "The question", 2000)
        options = data.get("options")
        if (not isinstance(options, list) or not 2 <= len(options) <= 8
                or not all(isinstance(o, str) and 0 < len(o) <= 200 for o in options) or len(set(options)) != len(options)):
            raise Refused(400, "A vote has 2 to 8 different options.")
        room, task = data.get("room"), data.get("task")
        if room is not None:
            self.room(room)
        if task is not None:
            self.task(task)
        cur = self.db.execute("INSERT INTO votes (question, options, room, task, author, created) VALUES (?, ?, ?, ?, ?, ?)",
                              (question, json.dumps(options), room, task, author, time.time()))
        if room is not None:
            self.db.execute("INSERT INTO messages (room, author, kind, text, at) VALUES (?, ?, 'say', ?, ?)",
                            (room, author, f"Vote {cur.lastrowid}: {question} ({' / '.join(options)})", time.time()))
        self.events.append(("vote", cur.lastrowid))
        return self.vote(cur.lastrowid)

    def ballot(self, vote_id: int, seat: str, data: dict) -> dict:
        found = self.vote(vote_id)
        if found["closed"]:
            raise Refused(409, f"Vote {vote_id} is closed.")
        choice = data.get("choice")
        if choice not in found["options"]:
            raise Refused(400, f"Choose one of: {', '.join(found['options'])}.")
        reason = text(data.get("reason"), "reason", 2000, required=False)
        self.db.execute("INSERT OR REPLACE INTO ballots (vote, seat, choice, reason, weight, at) VALUES (?, ?, ?, ?, ?, ?)",
                        (vote_id, seat, choice, reason, self.weight(self.seat(seat)), time.time()))
        found = self.vote(vote_id)
        if not found["waiting_for"]:
            return self.close(vote_id)
        return found

    def close(self, vote_id: int) -> dict:
        self.db.execute("UPDATE votes SET closed = 1 WHERE id = ?", (vote_id,))
        found = self.vote(vote_id)
        if found["room"] is not None and found["leading"] is not None:
            outcome = (f"split ({found['margin']:.0%} margin): the council should ask for advice" if found["split"]
                       else f"{found['leading']} ({found['margin']:.0%} margin)")
            self.post(found["room"], "you", {"kind": "system", "text": f"Vote {vote_id} closed: {outcome}"})
        if found["split"]:
            self.events.append(("split", vote_id))
        return found

    def feedback(self, data: dict) -> dict:
        seat = text(data.get("seat"), "The seat", 40)
        self.seat(seat)
        kind = data.get("kind")
        if kind not in ("thumbs_up", "thumbs_down"):
            raise Refused(400, "Feedback is thumbs_up or thumbs_down.")
        self.add_trust(seat, TRUST_EVENTS[kind], text(data.get("reason"), "reason", 500, required=False) or kind)
        return self.seat(seat)


# -- The orchestrator -------------------------------------------------------------------------------
# One worker, one job at a time: the pool runs every seat, so seats asked at once would only slow
# each other down. It talks to seats through their API (nanobot serve, one session per room) and to
# the escalation model through OpenRouter, with the database lock held only for database work.

SEAT_HOST = os.environ.get("NANOBOREALIS_HALL_SEAT_HOST", "127.0.0.1")
OPENROUTER_URL = os.environ.get("NANOBOREALIS_HALL_OPENROUTER_URL", "https://openrouter.ai/api/v1/chat/completions")
SEAT_TIMEOUT = float(os.environ.get("NANOBOREALIS_HALL_SEAT_TIMEOUT", "1800"))  # a CPU pool is slow to read
CONTINUOUS_EVERY = float(os.environ.get("NANOBOREALIS_HALL_CONTINUOUS_EVERY", "300"))
WATCHDOG_EVERY = float(os.environ.get("NANOBOREALIS_HALL_WATCHDOG_EVERY", "60"))
MAIL_AFTER = float(os.environ.get("NANOBOREALIS_HALL_MAIL_AFTER", "120"))  # mail a seat hasn't taken for this long is tried again
TASK_AFTER = float(os.environ.get("NANOBOREALIS_HALL_TASK_AFTER", "1800"))  # a task held and quiet for this long is nudged
CONTEXT_MESSAGES = 20  # the room's newest messages a seat is shown when it's asked to speak
FREE_ONLY = {"provider": {"max_price": {"prompt": 0, "completion": 0, "request": 0, "image": 0}}}
PASS = re.compile(r"^\W*pass\W*$", re.IGNORECASE)


def post_json(url: str, body: dict, key: str, timeout: float) -> dict:
    import urllib.request
    request = urllib.request.Request(url, data=json.dumps(body).encode(), method="POST",
                                     headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.loads(response.read())


def reply_text(answer: dict) -> str:
    try:
        return str(answer["choices"][0]["message"]["content"] or "").strip()
    except (KeyError, IndexError, TypeError):
        return ""


def cloud_verdict(answer: str) -> tuple[str, str] | None:
    """A cloud seat's review: ("accept", why) or ("reject", why) from ACCEPT/REJECT on its first line; None if neither."""
    first, _, rest = (answer or "").strip().partition("\n")
    word = re.match(r"\W*(ACCEPT|REJECT)\b\W*(.*)", first, re.IGNORECASE)
    if not word:
        return None
    why = " ".join(x for x in (word.group(2).strip(), rest.strip()) if x)
    if word.group(1).lower() == "reject":
        return "reject", why or "rejected without a reason"
    return "accept", why


def cloud_choice(answer: str, options: list[str]) -> tuple[str, str] | None:
    """A cloud seat's ballot from "CHOICE: x / REASON: y"; the option must match one exactly (case aside)."""
    found = re.search(r"CHOICE:\s*(.+)", answer or "", re.IGNORECASE)
    if not found:
        return None
    said = found.group(1).strip().strip("\"'*.` ")
    choice = next((o for o in options if o.lower() == said.lower()), None)
    if choice is None:
        return None
    reason = re.search(r"REASON:\s*(.+)", answer, re.IGNORECASE)
    return choice, reason.group(1).strip()[:2000] if reason else ""


# Who is at work right now, for the app's live map of the crew. In memory: it is about this moment.
BUSY: dict[str, dict] = {}   # seat -> {"session": "task-5", "since": when the Hall asked it}
STEPS: dict[str, dict] = {}  # seat -> {"note": the tool it is using, "at": when}: sent by the seat's own agent


def doing(session: str) -> tuple[str, int | None]:
    """A session's name ("task-5", "hall-3", "mail-x", "vote-2", "direct-4") in words, and its task if it is one."""
    kind, _, rest = session.partition("-")
    number = int(rest) if rest.isdigit() else None
    words = {"task": f"working on task {rest}", "hall": "answering in a chat", "direct": "talking with you",
             "mail": "reading messages", "vote": "voting"}.get(kind, "thinking")
    return words, number if kind == "task" else None


class Orchestrator:
    def __init__(self, hall: Hall):
        import queue
        self.hall = hall
        self.jobs: queue.Queue = queue.Queue()
        self.busy = False
        self._vault = None
        self._vault_lock = threading.Lock()
        self.ledger = mixer.Ledger() if mixer else None  # who has been asked lately, and who is resting
        try:  # which free model does well at what survives a restart
            self.stats = mixer.Stats(STATE / "mix.sqlite") if mixer else None
        except Exception:
            self.stats = mixer.Stats() if mixer else None

    def vault(self):
        with self._vault_lock:  # parallel proposers all ask for it at once; it must be made once
            if self._vault is None:
                self._vault = tokenizer.Vault(STATE / "vault")
            return self._vault

    def start(self) -> None:
        threading.Thread(target=self.work, daemon=True).start()
        threading.Thread(target=self.continuous, daemon=True).start()
        threading.Thread(target=self.watchdog, daemon=True).start()

    def watchdog(self) -> None:
        """Every minute: mail a seat hasn't taken is delivered again (and given up on, telling the head), and a task held
        and quiet is nudged, then put back on the board."""
        while True:
            time.sleep(WATCHDOG_EVERY)
            try:
                if rigs is not None:
                    for item_id in self.db(lambda h: h.watchdog_scan(time.time(), MAIL_AFTER, TASK_AFTER))["again"]:
                        self.jobs.put(("inbox", item_id))
            except Exception as e:
                print(f"nanoborealis-hall: the watchdog failed: {type(e).__name__}", file=sys.stderr, flush=True)

    def kick(self, events: list[tuple]) -> None:
        for event in events:
            self.jobs.put(event)

    def idle(self) -> bool:
        return not self.busy and self.jobs.empty()

    def db(self, fn):
        """fn(hall) in one transaction, under the lock."""
        with self.hall.lock:
            self.hall.db.execute("BEGIN IMMEDIATE")
            try:
                result = fn(self.hall)
                self.hall.db.execute("COMMIT")
            except BaseException:
                self.hall.db.execute("ROLLBACK")
                self.hall.events = []  # nothing happened, so there's nothing to act on
                raise
            events, self.hall.events = self.hall.events, []
        self.kick(events)
        return result

    def work(self) -> None:
        while True:
            job = self.jobs.get()
            self.busy = True
            try:
                getattr(self, f"on_{job[0]}")(*job[1:])
            except Exception as e:  # one failed job never stops the Hall
                print(f"nanoborealis-hall: {job[0]} {job[1:]} failed: {e}", file=sys.stderr, flush=True)
            finally:
                self.busy = False

    def continuous(self) -> None:
        """In continuous mode, open tasks are offered again every few minutes while the Hall is idle."""
        while True:
            time.sleep(CONTINUOUS_EVERY)
            try:
                if self.idle() and self.db(lambda h: h.settings()["autonomy"]) == "continuous":
                    for task in self.db(lambda h: h.tasks("open")):
                        self.jobs.put(("task", task["id"]))
            except Exception as e:
                print(f"nanoborealis-hall: the continuous round failed: {e}", file=sys.stderr, flush=True)

    # -- Talking to seats and the advisor ----------------------------------------------------------------

    def seats(self, exclude: tuple = ()) -> list[dict]:
        """The seats the Hall can ask (they have an API: every seat but the chair), weightiest first."""
        def find(h: Hall) -> list[dict]:
            rows = {r["id"]: r for r in h.db.execute("SELECT id, port, api_key FROM seats WHERE port IS NOT NULL OR kind = 'cloud'")}
            found = [{**h.seat(i), "port": r["port"], "api_key": r["api_key"]} for i, r in rows.items() if i not in exclude]
            return sorted(found, key=lambda s: -s["weight"])
        return self.db(find)

    def briefing(self, seat: dict) -> str:
        """What a seat in a rig is told first: the team's norms, its pod's guidance, its own role."""
        if rigs is None or not seat.get("rig"):
            return ""

        def find(h: Hall):
            rig = h.db.execute("SELECT name, culture FROM rigs WHERE name = ?", (seat["rig"],)).fetchone()
            pod = h.db.execute("SELECT id, guidance FROM pods WHERE rig = ? AND id = ?", (seat["rig"], seat.get("pod"))).fetchone()
            return (dict(rig) if rig else None, dict(pod) if pod else None)
        rig, pod = self.db(find)
        return rigs.briefing(rig, pod, seat)

    def notify_head(self, words: str) -> None:
        """Tell the head agent, if the rig has put anyone in line to be one."""
        try:
            if rigs is not None and self.db(lambda h: h.head())["line"]:
                self.db(lambda h: h.send("hall", {"to": "head", "text": words}))
        except Refused:
            pass

    def ask(self, seat: dict, session: str, prompt: str) -> str:
        """One turn of the seat's agent, in its session for this room or task; "" if it didn't answer."""
        # Models guess the date from their training and call true things "in the future": tell them.
        prompt = f"Today is {time.strftime('%A, %B %d, %Y')}. Trust this date over your own sense of it.\n\n{prompt}"
        brief = self.briefing(seat)
        BUSY[seat["id"]] = {"session": session, "since": time.time()}
        try:
            return self.ask_now(seat, session, prompt, brief)
        finally:
            BUSY.pop(seat["id"], None)
            STEPS.pop(seat["id"], None)

    def ask_now(self, seat: dict, session: str, prompt: str, brief: str) -> str:
        if seat.get("kind") == "cloud":
            return self.ask_cloud(seat, session, prompt, brief)
        if brief:
            prompt = f"{brief}\n\n{prompt}"
        try:
            answer = post_json(f"http://{SEAT_HOST}:{seat['port']}/v1/chat/completions",
                               {"model": seat["model"], "session_id": session,
                                "messages": [{"role": "user", "content": prompt}]}, seat["api_key"], SEAT_TIMEOUT)
        except Exception as e:
            print(f"nanoborealis-hall: {seat['id']} didn't answer: {e}", file=sys.stderr, flush=True)
            return ""
        return reply_text(answer)

    def cloud_source(self):
        """OpenRouter, free models only, through the tokenizer; None when nothing may go to the cloud."""
        key_file = STATE / "openrouter.key"
        if not key_file.exists() or tokenizer is None or sources is None or CLOUD_OFF:
            return None
        return sources.Source("openrouter", OPENROUTER_URL.removesuffix("/chat/completions"), "external",
                              free_only=True, extra=FREE_ONLY, key_file=str(key_file))

    def ask_cloud(self, seat: dict, session: str, prompt: str, brief: str) -> str:
        """One turn of a cloud seat: its model is asked directly, with its briefing and its recent turns in this
        session (the Hall keeps them, as a seat's own agent would). It has no tools: the Hall acts on its answer."""
        source = self.cloud_source()
        if source is None:
            print(f"nanoborealis-hall: {seat['id']} is a cloud seat, and there's no OpenRouter key or the cloud is off",
                  file=sys.stderr, flush=True)
            return ""
        past = self.db(lambda h: [dict(r) for r in h.db.execute(
            "SELECT role, text FROM (SELECT * FROM turns WHERE seat = ? AND session = ? ORDER BY id DESC LIMIT ?) ORDER BY id",
            (seat["id"], session, CLOUD_TURNS))])
        system = (brief + "\n\n" if brief else "") + (
            f"You are {seat.get('address') or seat['id']}, a member of a team of AI agents on the owner's own computer. "
            "Stay on what you are asked now; earlier subjects matter only if this message brings them up. "
            "Answer in plain text. You have no tools: when asked for a fixed form (PASS, ACCEPT, REJECT, CHOICE), use it exactly.")
        messages = [{"role": "system", "content": system}, *({"role": p["role"], "content": p["text"]} for p in past),
                    {"role": "user", "content": prompt}]
        try:
            answer = sources.chat_once("openrouter", seat["model"], messages, source=source, vault_factory=self.vault,
                                       timeout=SEAT_TIMEOUT).strip()
        except Exception as e:  # never print the prompt: only what went wrong
            # The error's status and kind only (SourceError carries no prompt text).
            print(f"nanoborealis-hall: {seat['id']} didn't answer: {type(e).__name__} {e if isinstance(e, sources.SourceError) else ''}",
                  file=sys.stderr, flush=True)
            return ""
        if answer:
            now = time.time()
            self.db(lambda h: h.db.executemany("INSERT INTO turns (seat, session, role, text, at) VALUES (?, ?, ?, ?, ?)",
                                               [(seat["id"], session, "user", prompt[:TEXT_LIMIT], now),
                                                (seat["id"], session, "assistant", answer[:TEXT_LIMIT], now)]))
        return answer

    def advise(self, question: str) -> str:
        """The escalation model's advice, free models only; "" when escalation can't run."""
        settings = self.db(lambda h: h.settings())
        key_file = STATE / "openrouter.key"
        if (not settings["escalation"] or not str(settings["escalation_model"]).endswith(":free")
                or not key_file.exists() or tokenizer is None or CLOUD_OFF):
            return ""
        messages = [{"role": "system", "content": "You advise a council of smaller AI models that is stuck or split. Answer "
                                                  "the question directly and briefly, with your reasoning."},
                    {"role": "user", "content": question}]
        # A free cloud model may log what it is sent. Every call here goes through sources.chat_once, which
        # tokenizes it (personal details swapped for placeholders only this computer can read, different ones
        # for each model) and restores the answer. If the tokenizer can't run, nothing is sent.
        source = sources.Source("openrouter", OPENROUTER_URL.removesuffix("/chat/completions"), "external",
                                free_only=True, extra=FREE_ONLY, key_file=str(key_file))

        def call(member, msgs):
            return sources.chat_once("openrouter", member.model, msgs, source=source, vault_factory=self.vault, timeout=300)

        try:
            chosen = settings["escalation_model"]
            if not settings.get("escalation_mix"):  # one model, the one the owner picked
                return call(mixer.Member("openrouter", chosen, chosen.split("/")[0], 65), messages).strip()
            members = list(mixer.DEFAULT_MEMBERS)
            if all(m.model != chosen for m in members):  # the owner's pick joins as an anchor
                members.append(mixer.Member("openrouter", chosen, chosen.split("/")[0], 65))
            task = mixer.Task(messages, kind="reasoning", stakes="high")  # several makes answer, one combines, another checks
            return mixer.Mixer(members, call, self.ledger, self.stats).run(task).answer.strip()
        except Exception as e:  # never print the question: only what went wrong
            print(f"nanoborealis-hall: escalation failed: {type(e).__name__}", file=sys.stderr, flush=True)
            return ""

    def say(self, room: int, author: str, text: str) -> None:
        if PASS.match(text):
            self.db(lambda h: h.post(room, author, {"kind": "pass"}))
        elif text:
            self.db(lambda h: h.post(room, author, {"text": text[:TEXT_LIMIT]}))

    # -- Jobs ----------------------------------------------------------------------------------------

    def on_room(self, room_id: int) -> None:
        """You spoke in a room: in a one-on-one room its seat answers; in the Hall, every seat in turn,
        each seeing what the others said before it."""
        room = self.db(lambda h: h.room(room_id))
        if room["kind"] == "direct":
            seat = next((s for s in self.seats() if s["id"] == room["seat"]), None)
            last = self.db(lambda h: h.messages(room_id))[-1]
            if seat and last["author"] == "you":
                self.say(room_id, seat["id"], self.ask(seat, f"direct-{room_id}", last["text"]) or "(no answer)")
            return
        seats = self.seats()
        board = self.scoreboard(seats)
        for seat in seats:
            recent = self.db(lambda h: h.messages(room_id))[-CONTEXT_MESSAGES:]
            lines = "\n".join(f"[{m['author']}{' · ' + m['card'] if m.get('card') else ''}] {m['text']}"
                              for m in recent if m["kind"] != "pass")
            # The work board, in every chat: the owner talks about "the task on the board", and seats that couldn't
            # see it asked them to repeat it.
            work = self.work_board()
            take = ("\nTo take on an open task yourself, start your reply with CLAIM <its number> on its own line, "
                    "then give the finished work." if seat.get("kind") == "cloud" and "[open]" in work else "")
            prompt = (f"The Hall, room {room_id}: {room['title']}\n\n{board}{work}{lines}\n\nYou are {seat['id']}. Reply to "
                      f"the room in a few sentences if you add something new, or answer exactly PASS.{take}")
            answer = self.ask(seat, f"hall-{room_id}", prompt)
            claimed = re.match(r"\s*CLAIM\s+#?(\d+)\s*\n(.*)", answer or "", re.S | re.I)
            if claimed and seat.get("kind") == "cloud":
                task_id, work_done = int(claimed.group(1)), claimed.group(2).strip()
                try:
                    self.db(lambda h: (h.claim(task_id, seat["id"]), h.submit(task_id, seat["id"], {"result": work_done or "(no result)"})))
                    answer = f"I took task {task_id} and handed it in for review:\n\n{work_done}"
                except Refused as e:
                    answer = f"I tried to take task {task_id}, but {e}"
            self.say(room_id, seat["id"], answer)

    def work_board(self) -> str:
        """The tasks not finished yet, for a seat's prompt: what the owner means by "the board"."""
        tasks = [x for x in self.db(lambda h: h.tasks()) if x["state"] in ("open", "claimed", "review")]
        if not tasks:
            return "The work board is empty.\n\n"
        rows = "\n".join(f"- task {x['id']} [{x['state']}{', ' + x['claimed_by'] if x.get('claimed_by') else ''}]: "
                         f"{x['title']}" + (f" ({x['detail'][:300]})" if x.get("detail") else "") for x in tasks[:20])
        return f"The work board (tasks not finished yet):\n{rows}\n\n"

    def scoreboard(self, seats: list[dict]) -> str:
        """The council's benchmarks, for a prompt: each seat's NanoBench scores, so a seat can weigh what the
        others say by what they are good at, and tell whether to claim a task or leave it to a better one."""
        if not any(s.get("scorecard") for s in seats):
            return ""
        rows = "\n".join(f"- {s['id']}: {card_text(s.get('scorecard') or {})}" for s in seats)
        return ("The council's scorecard, from tests of this council's own kind of work graded by code. The figure after '>=' "
                "is the low end of a 95% interval: trust it over the bare score. Weigh what each seat says by what it is "
                f"good at:\n{rows}\n\n")

    def on_task(self, task_id: int) -> None:
        """Offer an open task to the seats, weightiest first, until one takes it on."""
        seats = self.seats()
        board = self.scoreboard(seats)
        for seat in seats:
            task = self.db(lambda h: h.task(task_id))
            if task["state"] != "open":
                return
            if seat.get("kind") == "cloud":  # no tools: its answer is the work, or PASS
                answer = self.ask(seat, f"task-{task_id}",
                                  f"{board}Task {task_id} is open on the team's board: {task['title']}\n\n{task['detail']}\n\n"
                                  "If you can do it well, reply with the finished work itself, and nothing else. If it isn't "
                                  "for you, or a seat above is better at this kind of work, answer exactly PASS.")
                if answer and not PASS.match(answer):
                    try:
                        self.db(lambda h: (h.claim(task_id, seat["id"]), h.submit(task_id, seat["id"], {"result": answer})))
                    except Refused:
                        pass  # someone else took it meanwhile
                    return
                continue
            self.ask(seat, f"task-{task_id}",
                     f"{board}Task {task_id} is open on the council's board: {task['title']}\n\n{task['detail']}\n\n"
                     "If you can do it well, claim it with task_claim, do it, and hand it in with task_submit. "
                     "If it isn't for you, or a seat above is better at this kind of work, answer exactly PASS.")

    def on_review(self, task_id: int) -> None:
        task = self.db(lambda h: h.task(task_id))
        if task["state"] != "review":
            return
        # A rig can name who reviews whom (an edge of kind "reviews"). A named reviewer the Hall can ask is asked;
        # one it can't (an outside seat, Claude's) gets the review as mail and takes it from its inbox.
        edge = self.db(lambda h: h.db.execute("SELECT src FROM edges WHERE dst = ? AND kind = 'reviews' LIMIT 1",
                                              (task["claimed_by"],)).fetchone())
        named = edge["src"] if edge else None
        askable = self.seats(exclude=(task["claimed_by"],))
        reviewer = next((s for s in askable if s["id"] == named), None) or (None if named else next(iter(askable), None))
        if named and reviewer is None:
            self.db(lambda h: h.send("hall", {"to": named, "kind": "task", "text":
                    f"Please review task {task_id} ({task['title']}), handed in by {task['claimed_by']}:\n\n{task['result']}\n\n"
                    "Accept it or reject it with your reasons, on the task."}))
            return
        if reviewer is None:
            return  # a council of one: the person reviews it
        try:
            author = card_text(self.db(lambda h: h.seat(task["claimed_by"]))["scorecard"])
        except Refused:
            author = "not benchmarked yet"
        handed = (f"{task['claimed_by']} (its scorecard: {author}) handed in task {task_id} ({task['title']}):\n\n"
                  f"{task['detail']}\n\nThe work:\n{task['result']}\n\n")
        if reviewer.get("kind") == "cloud":  # no tools: ACCEPT, or REJECT and why
            answer = self.ask(reviewer, f"task-{task_id}", handed + "Review it honestly. Answer ACCEPT on the first line if it "
                              "does the task well, or REJECT on the first line and then what's wrong.")
            verdict = cloud_verdict(answer)
            if verdict:
                try:
                    self.db(lambda h: h.review(task_id, reviewer["id"], {"verdict": verdict[0], "text": verdict[1]}))
                except Refused:
                    pass
            return
        self.ask(reviewer, f"task-{task_id}", handed +
                 "Review it honestly with task_review: accept it, or reject it and say what's wrong. "
                 "A seat weak at review shouldn't wave work through, and a strong author still needs checking.")

    def on_revise(self, task_id: int) -> None:
        task = self.db(lambda h: h.task(task_id))
        worker = next((s for s in self.seats() if s["id"] == task["claimed_by"]), None)
        if worker is None or task["state"] != "claimed":
            return
        why = next((n["text"] for n in reversed(task["notes"]) if n["kind"] == "reject"), "")
        if worker.get("kind") == "cloud":
            answer = self.ask(worker, f"task-{task_id}", f"Your work on task {task_id} was sent back: {why}\n\n"
                                                         "Reply with the corrected work itself, and nothing else.")
            if answer:
                try:
                    self.db(lambda h: h.submit(task_id, worker["id"], {"result": answer}))
                except Refused:
                    pass
            return
        self.ask(worker, f"task-{task_id}", f"Your work on task {task_id} was sent back: {why}\n\n"
                                            "Fix it and hand it in again with task_submit.")

    def on_failed(self, task_id: int) -> None:
        task = self.db(lambda h: h.task(task_id))
        advice = self.advise(f"Task: {task['title']}\n{task['detail']}\n\nThe council's attempt:\n{task['result']}\n\n"
                             "Reviews: " + "; ".join(n["text"] for n in task["notes"] if n["kind"] == "reject"))
        if advice:
            self.db(lambda h: h.note(task_id, "advisor", "advice", advice))
        self.notify_head(f"Task {task_id} ({task['title']}) failed review twice" + (", and outside advice is on the task." if advice else "."))

    def on_inbox(self, item_id: int) -> None:
        """Mail for a seat the Hall can ask: it is asked to act on it, and its answer goes back to the sender. A seat the
        Hall can't ask (an outside seat, the chair, you) takes its mail from its inbox itself."""
        item = self.db(lambda h: (lambda r: dict(r) if r else None)(h.db.execute("SELECT * FROM inbox WHERE id = ?", (item_id,)).fetchone()))
        if item is None or item["state"] != "new":
            return
        seat = next((s for s in self.seats() if s["id"] == item["recipient"]), None)
        if seat is None:
            return
        self.db(lambda h: h.db.execute("UPDATE inbox SET state = 'delivered', tries = tries + 1, delivered = ? WHERE id = ?",
                                       (time.time(), item_id)))
        sender = item["sender"]
        answer = self.ask(seat, f"mail-{seat['id']}", f"Mail from {sender} ({item['kind']}): {item['text']}\n\n"
                                                      f"Do what it asks, or answer it. What you say goes back to {sender}.")
        if not answer:  # it didn't answer: the mail goes back to new, and the watchdog tries again
            self.db(lambda h: h.db.execute("UPDATE inbox SET state = 'new' WHERE id = ?", (item_id,)))
            return
        self.db(lambda h: h.ack(item_id, "admin", "done"))
        if sender != "hall" and item["kind"] != "reply":
            try:
                self.db(lambda h: h.send(seat["id"], {"to": sender, "kind": "reply", "text": answer[:8000], "reply_to": item_id}))
            except Refused:
                pass  # the sender is gone

    def on_vote(self, vote_id: int) -> None:
        seats = self.seats()
        board = self.scoreboard(seats)
        for seat in seats:
            vote = self.db(lambda h: h.vote(vote_id))
            if vote["closed"]:
                return
            if seat["id"] in vote["waiting_for"] and seat.get("kind") == "cloud":
                answer = self.ask(seat, f"vote-{vote_id}", f"{board}The team is voting (vote {vote_id}): {vote['question']}\n"
                                  f"Options: {' / '.join(vote['options'])}\n\nAnswer with CHOICE: <one option, exactly as "
                                  "written> on the first line and REASON: <one sentence> on the second.")
                choice = cloud_choice(answer, vote["options"])
                if choice:
                    try:
                        self.db(lambda h: h.ballot(vote_id, seat["id"], {"choice": choice[0], "reason": choice[1]}))
                    except Refused:
                        pass
            elif seat["id"] in vote["waiting_for"]:
                self.ask(seat, f"vote-{vote_id}", f"{board}The council is voting (vote {vote_id}): {vote['question']}\n"
                                                  f"Options: {' / '.join(vote['options'])}\n\n"
                                                  "Cast your ballot with the vote tool, with a short reason.")

    def on_split(self, vote_id: int) -> None:
        vote = self.db(lambda h: h.vote(vote_id))
        if vote["room"] is None:
            return
        reasons = "\n".join(f"- {b['seat']} chose {b['choice']}: {b['reason']}" for b in vote["ballots"])
        self.notify_head(f"The council split on: {vote['question']}\n{reasons}")
        self.db(lambda h: h.post(vote["room"], "hall", {"kind": "escalation", "text":
                                 f"The council split on: {vote['question']}\n{reasons}\nWhich is right, and why?"}))

    def on_escalation(self, room_id: int, message_id: int) -> None:
        asked = next(m for m in self.db(lambda h: h.messages(room_id, message_id - 1, 1)))
        advice = self.advise(asked["text"])
        self.db(lambda h: h.post(room_id, "advisor", {"text": advice or "No advice: escalation is off, or there's no OpenRouter key yet.",
                                                     "reply_to": message_id}))


# -- HTTP -------------------------------------------------------------------------------------------

def number(value: str, what: str) -> int:
    if not value.isdigit():
        raise Refused(404, f"No such {what}.")
    return int(value)


def route(hall: Hall, who: str, method: str, parts: list[str], query: dict, data: dict):
    admin = who == "admin"
    me = "you" if admin else who  # people speak through the admin token, as "you"

    def admin_only() -> None:
        if not admin:
            raise Refused(403, "Only the computer's own services can do that.")

    match method, parts:
        case "GET", ["me"]:
            return {"admin": True} if admin else hall.seat(who)
        case "GET", ["settings"]:
            return hall.settings()
        case "POST", ["settings"]:
            admin_only()
            return hall.set_settings(data)
        case "GET", ["rigs"]:
            return {"rigs": hall.rig_list()}
        case "POST", ["rigs"]:
            admin_only()
            return hall.rig_apply(data)
        case "GET", ["rigs", name]:
            return hall.rig(name)
        case "DELETE", ["rigs", name]:
            admin_only()
            return hall.rig_down(name, data.get("snapshot", True) is not False)
        case "POST", ["rigs", name, "snapshot"]:
            admin_only()
            return hall.rig_snapshot(name, data.get("label", ""))
        case "POST", ["rigs", name, "restore"]:
            admin_only()
            return hall.rig_restore(name, data)
        case "POST", ["inbox"]:
            return hall.send(me, data)
        case "GET", ["inbox"]:
            return {"mail": hall.mail(query["seat"] if admin and query.get("seat") else me, query.get("state"))}
        case "POST", ["inbox", item, "ack"]:
            return hall.ack(number(item, "mail"), who, data.get("state", "done"))
        case "POST", ["presence"]:
            if admin:
                raise Refused(403, "Only seats send a heartbeat.")
            return hall.beat(who, data)
        case "GET", ["activity"]:
            try:
                since = float(query.get("since") or 0)
            except ValueError:
                since = 0.0
            return hall.activity(since)
        case "POST", ["activity"]:
            if admin:
                raise Refused(403, "Only seats say what they are doing.")
            return hall.step(who, data)
        case "GET", ["head"]:
            return hall.head()
        case "POST", ["benchmarks"]:
            admin_only()  # the computer's own services run the tests; a seat can't mark its own work
            return hall.bench_record(data)
        case "GET", ["benchmarks"]:
            return {"benchmarks": hall.benchmarks(query.get("model"))}
        case "POST", ["escalation-key"]:
            # The OpenRouter key escalation uses: the chair's own, copied here by `council apply` and
            # whenever the app sets a new one. Used for free models only.
            admin_only()
            key = text(data.get("key"), "The key", 300)
            if not re.fullmatch(r"sk-or-[\w\-]{16,200}", key):
                raise Refused(400, "That isn't an OpenRouter key.")
            path = STATE / "openrouter.key"
            path.touch(mode=0o600)
            path.write_text(key + "\n")
            return {"saved": True}
        case "GET", ["seats"]:
            return {"seats": hall.seats()}
        case "POST", ["seats"]:
            admin_only()
            return hall.put_seat(data)
        case "DELETE", ["seats", seat_id]:
            admin_only()
            return hall.remove_seat(seat_id)
        case "POST", ["feedback"]:
            admin_only()
            return hall.feedback(data)
        case "GET", ["rooms"]:
            return {"rooms": hall.rooms()}
        case "POST", ["rooms"]:
            admin_only()
            return hall.new_room(data)
        case "GET", ["rooms", room, "messages"]:
            return {"messages": hall.messages(number(room, "room"), int(query.get("after", "0") or 0))}
        case "POST", ["rooms", room, "messages"]:
            return hall.post(number(room, "room"), me, data)
        case "GET", ["tasks"]:
            return {"tasks": hall.tasks(query.get("state"))}
        case "POST", ["tasks"]:
            return hall.new_task(me, data)
        case "GET", ["tasks", task]:
            return hall.task(number(task, "task"))
        case "POST", ["tasks", task, "reopen"]:
            admin_only()
            return hall.reopen(number(task, "task"))
        case "POST", ["tasks", task, "review"]:
            return hall.review(number(task, "task"), me, data)
        case "POST", ["tasks", task, action] if action in ("claim", "update", "submit"):
            if admin:
                raise Refused(403, "Seats claim and work on tasks; people post and review them.")
            task_id = number(task, "task")
            return {"claim": lambda: hall.claim(task_id, who), "update": lambda: hall.update(task_id, who, data),
                    "submit": lambda: hall.submit(task_id, who, data)}[action]()
        case "GET", ["votes"]:
            return {"votes": hall.votes(open_only=query.get("open") == "1")}
        case "POST", ["votes"]:
            return hall.new_vote(me, data)
        case "GET", ["votes", vote]:
            return hall.vote(number(vote, "vote"))
        case "POST", ["votes", vote, "ballot"]:
            if admin:
                raise Refused(403, "Only seats vote.")
            return hall.ballot(number(vote, "vote"), who, data)
        case "POST", ["votes", vote, "close"]:
            admin_only()
            return hall.close(number(vote, "vote"))
    raise Refused(404, "No such endpoint.")


def shield(vault, node, scope: str):
    """Every string in an answer, tokenized for `scope` (keys and numbers stay as they are)."""
    if isinstance(node, str):
        return vault.tokenize(node, scope)
    if isinstance(node, list):
        return [shield(vault, v, scope) for v in node]
    if isinstance(node, dict):
        return {k: shield(vault, v, scope) for k, v in node.items()}
    return node


def handler(hall: Hall, orchestrator: Orchestrator) -> type[BaseHTTPRequestHandler]:
    class Handler(BaseHTTPRequestHandler):
        server_version = "nanoborealis-hall"

        def log_message(self, fmt: str, *args) -> None:  # requests aren't logged; changes are in the database
            pass

        def answer(self, status: int, payload: object) -> None:
            body = json.dumps(payload).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def handle_any(self) -> None:
            try:
                auth = self.headers.get("Authorization", "")
                with hall.lock:
                    who = hall.who(auth.removeprefix("Bearer ").strip() if auth.startswith("Bearer ") else "")
                if who is None:
                    raise Refused(401, "Unknown token.")
                length = int(self.headers.get("Content-Length") or 0)
                if not 0 <= length <= MAX_BODY:
                    raise Refused(413, "Too large.")
                data = json.loads(self.rfile.read(length) or b"{}") if length else {}
                if not isinstance(data, dict):
                    raise Refused(400, "The body is a JSON object.")
                url = urlsplit(self.path)
                parts = [p for p in url.path.split("/") if p]
                query = {k: v[-1] for k, v in parse_qs(url.query).items()}
                outside = who != "admin" and orchestrator.db(lambda h: h.seat(who)["external"])
                if outside:
                    # An outside seat is an agent in someone else's cloud, so the Hall is the privacy boundary:
                    # it is shown the Hall tokenized (with placeholders of its own), what it writes is restored
                    # before the council reads it, and with no tokenizer it isn't served at all.
                    if tokenizer is None:
                        raise Refused(503, "Outside seats need the tokenizer, which isn't installed.")
                    data = orchestrator.vault().restore(data)
                result = orchestrator.db(lambda h: route(h, who, self.command, parts, query, data))
                if outside:
                    result = shield(orchestrator.vault(), result, f"seat-{who}")
                self.answer(200, result)
            except Refused as e:
                self.answer(e.status, {"error": str(e)})
            except (ValueError, json.JSONDecodeError):
                self.answer(400, {"error": "Bad request."})

        do_GET = do_POST = do_DELETE = handle_any

    return Handler


def main() -> None:
    host, _, port = LISTEN.rpartition(":")
    hall = Hall(STATE)
    orchestrator = Orchestrator(hall)
    orchestrator.start()
    server = ThreadingHTTPServer((host or "127.0.0.1", int(port)), handler(hall, orchestrator))
    print(f"nanoborealis-hall: the council's Hall on {LISTEN}", file=sys.stderr, flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
