#!/usr/bin/bash
# SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
# Copyright (C) 2026 korxspyre
# Fixes a setup left by an older installer. Runs at every boot; each step acts only when it finds the
# old layout, so it is a no-op on fresh installs and after the first run.
set -uo pipefail

did=0
log() { echo "nanoborealis-migrate: $*"; did=1; }

# fstab from the installer. Its root line can't apply on a composefs root (systemd-remount-fs failed on every
# boot: "overlay: No changes allowed in reconfigure"; the kernel's root= mounts it anyway), and /home there is a
# link to var/home, so the home subvolume belongs at /var/home. A copy of the old file stays beside it.
if [ -f /etc/fstab ] && [ "$(findmnt -n -o FSTYPE / 2>/dev/null)" = "overlay" ] && grep -Eq '^[^#[:space:]]+[[:space:]]+/[[:space:]]+btrfs[[:space:]]' /etc/fstab; then
    cp -a /etc/fstab /etc/fstab.before-nanoborealis
    sed -i -E 's|^([^#[:space:]]+[[:space:]]+/[[:space:]]+btrfs[[:space:]].*)$|# composefs root, mounted by the kernel; remounting it failed every boot: \1|' /etc/fstab
    log "fstab: the root line no longer fails systemd-remount-fs at boot"
fi
if [ -f /etc/fstab ] && [ -L /home ] && grep -Eq '^[^#[:space:]]+[[:space:]]+/home[[:space:]]+btrfs[[:space:]]' /etc/fstab; then
    [ -e /etc/fstab.before-nanoborealis ] || cp -a /etc/fstab /etc/fstab.before-nanoborealis
    sed -i -E 's|^([^#[:space:]]+[[:space:]]+)/home([[:space:]]+btrfs[[:space:]])|\1/var/home\2|' /etc/fstab
    log "fstab: the home subvolume is mounted at /var/home, where /home points"
fi

[ "$did" -eq 1 ] || echo "nanoborealis-migrate: nothing to migrate"
exit 0
