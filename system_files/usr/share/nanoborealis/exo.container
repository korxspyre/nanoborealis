# Quadlet unit for this computer's pool node (exo). `nanoborealis pool join` copies it to
# ~nanoborealis-pool/.config/containers/systemd/, and systemd runs it as that account's service.

[Unit]
Description=NanoBorealis pool node (exo)
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/korxspyre/nanoborealis-pool:cpu
ContainerName=exo
# The host's network: pool nodes find each other and trade model layers over the local network.
Network=host
# Downloaded models and the node's identity survive restarts and image updates.
Volume=exo-home:/home/exo
UserNS=keep-id:uid=1000,gid=1000
Exec=@EXEC_ARGS@
# On a computer whose NVIDIA GPU the node uses, `pool join` puts the GPU here (through the NVIDIA
# Container Toolkit's CDI spec) and has exo report the GPU's memory instead of the computer's.
@GPU@
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=10
# The first start downloads the node image.
TimeoutStartSec=1800

[Install]
WantedBy=default.target
