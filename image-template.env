# SPDX-License-Identifier: Apache-2.0
# From the Universal Blue image template (https://github.com/ublue-os/image-template), changed for
# NanoBorealis by korxspyre. Like the template, this file is under the Apache License 2.0.
# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=nanoborealis

# Make this the same as your github username/organisation
REPO_ORGANIZATION="korxspyre"

IMAGE_DESC="NanoBorealis: an agentic Linux desktop built on Aurora, with a sandboxed AI agent"
IMAGE_KEYWORDS="bootc,oci,linux,nanoborealis,aurora,nanobot,ai-agent"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
# Every build of main lands on the dev channel; a release tag (vX.Y.Z) builds stable, which
# installed systems and the installer ISO follow.
DEFAULT_TAG="dev"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
